# Comma-separated frontend origins allowed to send credentialed browser requests.
# Development origins; production must use its explicit allowed-origin list.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Set to true behind HTTPS in production. Keep false for local HTTP development.
COOKIE_SECURE=false

# IP whitelist (additional layer on top of OFFICE_CIDRS).
# Only the exact value "true" enables it; when absent or any other value, the
# whitelist is off. When enabled, IP_WHITELIST_CIDRS is REQUIRED and must contain
# only valid CIDRs (comma-separated). Empty/invalid CIDRs fail closed: the server
# refuses to start instead of allowing every IP.
# Example for the current development network (laptop .174, iPhone .171):
#   IP_WHITELIST_ENABLED=true
#   IP_WHITELIST_CIDRS=192.168.30.0/24
# Note: with only 192.168.30.0/24, requests to http://localhost:3000 from the
# same machine are blocked because loopback is not in the whitelist. Add
# loopback entries if needed:
#   IP_WHITELIST_CIDRS=127.0.0.1/32,::1/128,192.168.30.0/24
# IP_WHITELIST_ENABLED=false
# IP_WHITELIST_CIDRS=
